// SAIPEI FOODS LIMITED - ERP / POS data model
// Target: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// ADMINISTRATION - users, roles, permissions, audit
// ---------------------------------------------------------------------------

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(80)
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id     String           @id @default(uuid()) @db.Uuid
  code   String           @unique @db.VarChar(80) // e.g. "pos.sell", "import.approve"
  module String           @db.VarChar(60)
  label  String           @db.VarChar(140)
  roles  RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(160)
  username     String    @unique @db.VarChar(60)
  fullName     String    @db.VarChar(140)
  phone        String?   @db.VarChar(30)
  passwordHash String    @db.VarChar(200)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  roleId       String    @db.Uuid
  role         Role      @relation(fields: [roleId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  branchId     String?   @db.Uuid
  branch       Branch?   @relation(fields: [branchId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs      AuditLog[]
  sales          Sale[]
  cashSessions   CashSession[]
  approvals      Approval[]        @relation("ApprovalActor")
  stockMovements StockMovement[]
  expenses       Expense[]
  payments       Payment[]
  receipts       Receipt[]
  stockTakes     StockTake[]
  adjustments    StockAdjustment[]
  transfersFrom  StockTransfer[]   @relation("TransferCreatedBy")

  @@index([roleId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  action    String   @db.VarChar(60) // CREATE | UPDATE | DELETE | APPROVE | VOID | LOGIN
  entity    String   @db.VarChar(80)
  entityId  String?  @db.VarChar(80)
  summary   String?  @db.VarChar(400)
  metadata  String?  @db.Text
  ipAddress String?  @db.VarChar(60)
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Setting {
  key       String   @id @db.VarChar(80)
  value     String   @db.Text
  group     String   @default("general") @db.VarChar(40)
  updatedAt DateTime @updatedAt
}

model Branch {
  id         String      @id @default(uuid()) @db.Uuid
  code       String      @unique @db.VarChar(20)
  name       String      @db.VarChar(120)
  location   String?     @db.VarChar(200)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  users      User[]
  warehouses Warehouse[]
  sales      Sale[]
}

// ---------------------------------------------------------------------------
// APPROVALS - shared workflow across modules
// ---------------------------------------------------------------------------

model Approval {
  id          String    @id @default(uuid()) @db.Uuid
  entity      String    @db.VarChar(80) // PurchaseOrder | Expense | StockAdjustment ...
  entityId    String    @db.VarChar(80)
  reference   String?   @db.VarChar(80)
  status      String    @default("PENDING") @db.VarChar(30)
  requestedBy String?   @db.VarChar(140)
  actorId     String?   @db.Uuid
  actor       User?     @relation("ApprovalActor", fields: [actorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  notes       String?   @db.VarChar(400)
  amount      Decimal?  @db.Decimal(18, 2)
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  @@index([entity, entityId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// PURCHASING - suppliers, orders, invoices, payments, returns
// ---------------------------------------------------------------------------

model Supplier {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(160)
  type        String   @default("FOREIGN") @db.VarChar(30)
  country     String?  @db.VarChar(80)
  contactName String?  @db.VarChar(120)
  phone       String?  @db.VarChar(40)
  email       String?  @db.VarChar(160)
  address     String?  @db.VarChar(300)
  taxPin      String?  @db.VarChar(40)
  currency    String   @default("USD") @db.VarChar(3)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]
  payments       Payment[]
  importOrders   ImportOrder[]
  returns        PurchaseReturn[]
}

model PurchaseOrder {
  id           String    @id @default(uuid()) @db.Uuid
  reference    String    @unique @db.VarChar(40) // LPO reference
  supplierId   String    @db.Uuid
  supplier     Supplier  @relation(fields: [supplierId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  currency     String    @default("USD") @db.VarChar(3)
  exchangeRate Decimal   @default(1) @db.Decimal(18, 6)
  subtotal     Decimal   @default(0) @db.Decimal(18, 2)
  taxAmount    Decimal   @default(0) @db.Decimal(18, 2)
  total        Decimal   @default(0) @db.Decimal(18, 2)
  status       String    @default("DRAFT") @db.VarChar(30)
  notes        String?   @db.VarChar(600)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lines       PurchaseOrderLine[]
  invoices    SupplierInvoice[]
  importOrders ImportOrder[]

  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderLine {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?       @db.Uuid
  product         Product?      @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  description     String        @db.VarChar(300)
  quantity        Decimal       @db.Decimal(18, 3)
  receivedQty     Decimal       @default(0) @db.Decimal(18, 3)
  unitPrice       Decimal       @db.Decimal(18, 4)
  lineTotal       Decimal       @db.Decimal(18, 2)

  @@index([purchaseOrderId])
}

model SupplierInvoice {
  id              String         @id @default(uuid()) @db.Uuid
  invoiceNumber   String         @db.VarChar(60)
  supplierId      String         @db.Uuid
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  purchaseOrderId String?        @db.Uuid
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  invoiceDate     DateTime       @default(now())
  dueDate         DateTime?
  currency        String         @default("USD") @db.VarChar(3)
  exchangeRate    Decimal        @default(1) @db.Decimal(18, 6)
  amount          Decimal        @db.Decimal(18, 2)
  amountPaid      Decimal        @default(0) @db.Decimal(18, 2)
  isFinal         Boolean        @default(false) // final invoice received before shipping
  status          String         @default("UNPAID") @db.VarChar(30)
  documentUrl     String?        @db.VarChar(400)
  notes           String?        @db.VarChar(600)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  payments Payment[]

  @@unique([supplierId, invoiceNumber])
  @@index([status])
}

model PurchaseReturn {
  id          String   @id @default(uuid()) @db.Uuid
  reference   String   @unique @db.VarChar(40)
  supplierId  String   @db.Uuid
  supplier    Supplier @relation(fields: [supplierId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  returnDate  DateTime @default(now())
  reason      String?  @db.VarChar(400)
  totalAmount Decimal  @default(0) @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  lines PurchaseReturnLine[]
}

model PurchaseReturnLine {
  id               String         @id @default(uuid()) @db.Uuid
  purchaseReturnId String         @db.Uuid
  purchaseReturn   PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)
  productId        String         @db.Uuid
  product          Product        @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  quantity         Decimal        @db.Decimal(18, 3)
  unitPrice        Decimal        @db.Decimal(18, 4)
  lineTotal        Decimal        @db.Decimal(18, 2)
}

// ---------------------------------------------------------------------------
// IMPORT & CLEARING - the China -> Mombasa -> warehouse pipeline
// ---------------------------------------------------------------------------

model ImportOrder {
  id              String         @id @default(uuid()) @db.Uuid
  reference       String         @unique @db.VarChar(40) // unique reference number (UCR-linked)
  supplierId      String         @db.Uuid
  supplier        Supplier       @relation(fields: [supplierId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  purchaseOrderId String?        @db.Uuid
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  orderDate       DateTime       @default(now())
  stage           String         @default("ORDER_PLACED") @db.VarChar(30)
  description     String?        @db.VarChar(400)
  currency        String         @default("USD") @db.VarChar(3)
  exchangeRate    Decimal        @default(1) @db.Decimal(18, 6)
  goodsValue      Decimal        @default(0) @db.Decimal(18, 2)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  shipments Shipment[]
  documents ImportDocument[]
  charges   LandedCostCharge[]

  @@index([stage])
}

model Shipment {
  id              String         @id @default(uuid()) @db.Uuid
  reference       String         @unique @db.VarChar(40)
  importOrderId   String         @db.Uuid
  importOrder     ImportOrder    @relation(fields: [importOrderId], references: [id], onDelete: Cascade)
  containerNumber String?        @db.VarChar(40)
  billOfLading    String?        @db.VarChar(60)
  vesselName      String?        @db.VarChar(120)
  loadingDate     DateTime?
  departureDate   DateTime?
  expectedArrival DateTime?
  actualArrival   DateTime?
  portOfLoading   String?        @db.VarChar(120)
  portOfDischarge String         @default("Mombasa") @db.VarChar(120)
  clearingAgentId String?        @db.Uuid
  clearingAgent   ClearingAgent? @relation(fields: [clearingAgentId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  agentNotifiedAt DateTime?
  releasedAt      DateTime?
  status          String         @default("PENDING") @db.VarChar(30)
  numberOfBales   Int            @default(0)
  totalWeightKg   Decimal        @default(0) @db.Decimal(18, 3)
  containerCost   Decimal        @default(0) @db.Decimal(18, 2)
  notes           String?        @db.VarChar(600)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customsEntries CustomsEntry[]
  goodsReceipts  GoodsReceipt[]
  charges        LandedCostCharge[]
  documents      ImportDocument[]

  @@index([importOrderId])
  @@index([status])
}

model ClearingAgent {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(30)
  name        String     @db.VarChar(160)
  contactName String?    @db.VarChar(120)
  phone       String?    @db.VarChar(40)
  email       String?    @db.VarChar(160)
  taxPin      String?    @db.VarChar(40)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  shipments   Shipment[]
}

model ImportDocument {
  id            String      @id @default(uuid()) @db.Uuid
  importOrderId String      @db.Uuid
  importOrder   ImportOrder @relation(fields: [importOrderId], references: [id], onDelete: Cascade)
  shipmentId    String?     @db.Uuid
  shipment      Shipment?   @relation(fields: [shipmentId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  type          String      @db.VarChar(30)
  reference     String?     @db.VarChar(80) // IDF number, UCR number, permit number
  issueDate     DateTime?
  expiryDate    DateTime?
  fileUrl       String?     @db.VarChar(400)
  notes         String?     @db.VarChar(400)
  createdAt     DateTime    @default(now())

  @@index([importOrderId])
  @@index([type])
}

model CustomsEntry {
  id             String    @id @default(uuid()) @db.Uuid
  shipmentId     String    @db.Uuid
  shipment       Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  entryNumber    String    @db.VarChar(60)
  entryDate      DateTime  @default(now())
  customsValue   Decimal   @default(0) @db.Decimal(18, 2)
  importDuty     Decimal   @default(0) @db.Decimal(18, 2)
  vat            Decimal   @default(0) @db.Decimal(18, 2)
  idfFee         Decimal   @default(0) @db.Decimal(18, 2)
  railwayLevy    Decimal   @default(0) @db.Decimal(18, 2)
  importDeclLevy Decimal   @default(0) @db.Decimal(18, 2)
  exciseDuty     Decimal   @default(0) @db.Decimal(18, 2)
  otherLevies    Decimal   @default(0) @db.Decimal(18, 2)
  totalTaxes     Decimal   @default(0) @db.Decimal(18, 2)
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([shipmentId])
}

model LandedCostCharge {
  id            String      @id @default(uuid()) @db.Uuid
  importOrderId String      @db.Uuid
  importOrder   ImportOrder @relation(fields: [importOrderId], references: [id], onDelete: Cascade)
  shipmentId    String?     @db.Uuid
  shipment      Shipment?   @relation(fields: [shipmentId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  category      String      @db.VarChar(30)
  description   String      @db.VarChar(300)
  currency      String      @default("KES") @db.VarChar(3)
  exchangeRate  Decimal     @default(1) @db.Decimal(18, 6)
  amount        Decimal     @db.Decimal(18, 2)
  amountKes     Decimal     @db.Decimal(18, 2)
  chargeDate    DateTime    @default(now())
  isPaid        Boolean     @default(false)
  payeeName     String?     @db.VarChar(160)
  reference     String?     @db.VarChar(80)
  createdAt     DateTime    @default(now())

  @@index([importOrderId])
  @@index([category])
}

// ---------------------------------------------------------------------------
// INVENTORY - products, bales, warehouses, stock
// ---------------------------------------------------------------------------

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(120)
  description String?   @db.VarChar(300)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id           String    @id @default(uuid()) @db.Uuid
  sku          String    @unique @db.VarChar(40)
  barcode      String?   @db.VarChar(60)
  name         String    @db.VarChar(200)
  description  String?   @db.VarChar(500)
  categoryId   String?   @db.Uuid
  category     Category? @relation(fields: [categoryId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  unit         String    @default("PIECE") @db.VarChar(30)
  costPrice    Decimal   @default(0) @db.Decimal(18, 4) // weighted average landed cost
  sellingPrice Decimal   @default(0) @db.Decimal(18, 2)
  reorderLevel Decimal   @default(0) @db.Decimal(18, 3)
  taxRate      Decimal   @default(0) @db.Decimal(5, 2) // VAT %
  isActive     Boolean   @default(true)
  imageUrl     String?   @db.VarChar(400)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  stockLevels     StockLevel[]
  saleLines       SaleLine[]
  poLines         PurchaseOrderLine[]
  movements       StockMovement[]
  bales           Bale[]
  returnLines     SalesReturnLine[]
  purchaseReturns PurchaseReturnLine[]
  adjustmentLines StockAdjustmentLine[]
  transferLines   StockTransferLine[]
  stockTakeLines  StockTakeLine[]
  grnLines        GoodsReceiptLine[]

  @@index([categoryId])
  @@index([isActive])
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(120)
  location  String?  @db.VarChar(200)
  branchId  String?  @db.Uuid
  branch    Branch?  @relation(fields: [branchId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockLevels   StockLevel[]
  movements     StockMovement[]
  goodsReceipts GoodsReceipt[]
  transfersFrom StockTransfer[]   @relation("TransferFrom")
  transfersTo   StockTransfer[]   @relation("TransferTo")
  adjustments   StockAdjustment[]
  stockTakes    StockTake[]
  bales         Bale[]
}

model StockLevel {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String    @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  quantity    Decimal   @default(0) @db.Decimal(18, 3)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model StockMovement {
  id           String    @id @default(uuid()) @db.Uuid
  productId    String    @db.Uuid
  product      Product   @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  warehouseId  String    @db.Uuid
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  type         String    @db.VarChar(30)
  quantity     Decimal   @db.Decimal(18, 3) // signed: + in, - out
  balanceAfter Decimal   @default(0) @db.Decimal(18, 3)
  unitCost     Decimal   @default(0) @db.Decimal(18, 4)
  reference    String?   @db.VarChar(80)
  sourceType   String?   @db.VarChar(60)
  sourceId     String?   @db.VarChar(80)
  userId       String?   @db.Uuid
  user         User?     @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  notes        String?   @db.VarChar(300)
  createdAt    DateTime  @default(now())

  @@index([productId, createdAt])
  @@index([warehouseId])
  @@index([type])
}

// Goods receiving - bale-level detail required by the spec
model GoodsReceipt {
  id              String    @id @default(uuid()) @db.Uuid
  reference       String    @unique @db.VarChar(40) // GRN number
  shipmentId      String?   @db.Uuid
  shipment        Shipment? @relation(fields: [shipmentId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  warehouseId     String    @db.Uuid
  warehouse       Warehouse @relation(fields: [warehouseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  receiptDate     DateTime  @default(now())
  containerNumber String?   @db.VarChar(40)
  numberOfBales   Int       @default(0)
  totalWeightKg   Decimal   @default(0) @db.Decimal(18, 3)
  containerCost   Decimal   @default(0) @db.Decimal(18, 2)
  offloadingCost  Decimal   @default(0) @db.Decimal(18, 2)
  transportCost   Decimal   @default(0) @db.Decimal(18, 2)
  warehouseCost   Decimal   @default(0) @db.Decimal(18, 2)
  verifiedBy      String?   @db.VarChar(140)
  notes           String?   @db.VarChar(600)
  isPosted        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bales Bale[]
  lines GoodsReceiptLine[]

  @@index([shipmentId])
}

model GoodsReceiptLine {
  id             String       @id @default(uuid()) @db.Uuid
  goodsReceiptId String       @db.Uuid
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  productId      String       @db.Uuid
  product        Product      @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  quantity       Decimal      @db.Decimal(18, 3)
  unitCost       Decimal      @db.Decimal(18, 4)
  lineTotal      Decimal      @db.Decimal(18, 2)

  @@index([goodsReceiptId])
}

// A physical bale of shoes - the unit the business actually receives
model Bale {
  id             String       @id @default(uuid()) @db.Uuid
  baleNumber     String       @unique @db.VarChar(40)
  goodsReceiptId String       @db.Uuid
  goodsReceipt   GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  warehouseId    String       @db.Uuid
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  productId      String?      @db.Uuid
  product        Product?     @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  shoeType       String       @db.VarChar(140) // bale type of shoes
  weightKg       Decimal      @db.Decimal(18, 3)
  balePrice      Decimal      @db.Decimal(18, 2) // purchase price of the bale
  landedCost     Decimal      @default(0) @db.Decimal(18, 2)
  piecesEstimate Int          @default(0)
  piecesSold     Int          @default(0)
  isOpened       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([goodsReceiptId])
  @@index([warehouseId])
}

model StockTransfer {
  id              String    @id @default(uuid()) @db.Uuid
  reference       String    @unique @db.VarChar(40)
  fromWarehouseId String    @db.Uuid
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  toWarehouseId   String    @db.Uuid
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  transferDate    DateTime  @default(now())
  status          String    @default("DRAFT") @db.VarChar(30)
  createdById     String?   @db.Uuid
  createdBy       User?     @relation("TransferCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction, onDelete: NoAction)
  notes           String?   @db.VarChar(400)
  createdAt       DateTime  @default(now())

  lines StockTransferLine[]
}

model StockTransferLine {
  id         String        @id @default(uuid()) @db.Uuid
  transferId String        @db.Uuid
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String        @db.Uuid
  product    Product       @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  quantity   Decimal       @db.Decimal(18, 3)
}

model StockAdjustment {
  id             String    @id @default(uuid()) @db.Uuid
  reference      String    @unique @db.VarChar(40)
  warehouseId    String    @db.Uuid
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  reason         String    @db.VarChar(30)
  adjustmentDate DateTime  @default(now())
  status         String    @default("PENDING") @db.VarChar(30)
  userId         String?   @db.Uuid
  user           User?     @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  notes          String?   @db.VarChar(400)
  createdAt      DateTime  @default(now())

  lines StockAdjustmentLine[]
}

model StockAdjustmentLine {
  id           String          @id @default(uuid()) @db.Uuid
  adjustmentId String          @db.Uuid
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId    String          @db.Uuid
  product      Product         @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  quantity     Decimal         @db.Decimal(18, 3) // signed
  unitCost     Decimal         @default(0) @db.Decimal(18, 4)
}

model StockTake {
  id          String    @id @default(uuid()) @db.Uuid
  reference   String    @unique @db.VarChar(40)
  warehouseId String    @db.Uuid
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  takeDate    DateTime  @default(now())
  status      String    @default("OPEN") @db.VarChar(30)
  userId      String?   @db.Uuid
  user        User?     @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  notes       String?   @db.VarChar(400)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  lines StockTakeLine[]
}

model StockTakeLine {
  id          String    @id @default(uuid()) @db.Uuid
  stockTakeId String    @db.Uuid
  stockTake   StockTake @relation(fields: [stockTakeId], references: [id], onDelete: Cascade)
  productId   String    @db.Uuid
  product     Product   @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  systemQty   Decimal   @db.Decimal(18, 3)
  countedQty  Decimal   @db.Decimal(18, 3)
  variance    Decimal   @db.Decimal(18, 3)
}

// ---------------------------------------------------------------------------
// SALES & POS
// ---------------------------------------------------------------------------

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(30)
  name        String   @db.VarChar(160)
  phone       String?  @db.VarChar(40)
  email       String?  @db.VarChar(160)
  address     String?  @db.VarChar(300)
  taxPin      String?  @db.VarChar(40)
  creditLimit Decimal  @default(0) @db.Decimal(18, 2)
  balance     Decimal  @default(0) @db.Decimal(18, 2) // outstanding receivable
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales    Sale[]
  receipts Receipt[]
  returns  SalesReturn[]

  @@index([isActive])
}

model Sale {
  id            String       @id @default(uuid()) @db.Uuid
  reference     String       @unique @db.VarChar(40) // receipt / invoice number
  channel       String       @default("POS") @db.VarChar(30)
  customerId    String?      @db.Uuid
  customer      Customer?    @relation(fields: [customerId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  branchId      String?      @db.Uuid
  branch        Branch?      @relation(fields: [branchId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  cashierId     String       @db.Uuid
  cashier       User         @relation(fields: [cashierId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  cashSessionId String?      @db.Uuid
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  saleDate      DateTime     @default(now())
  subtotal      Decimal      @default(0) @db.Decimal(18, 2)
  discount      Decimal      @default(0) @db.Decimal(18, 2)
  taxAmount     Decimal      @default(0) @db.Decimal(18, 2)
  total         Decimal      @default(0) @db.Decimal(18, 2)
  amountPaid    Decimal      @default(0) @db.Decimal(18, 2)
  changeGiven   Decimal      @default(0) @db.Decimal(18, 2)
  costOfSale    Decimal      @default(0) @db.Decimal(18, 2) // for profit reporting
  status        String       @default("COMPLETED") @db.VarChar(30)
  isCredit      Boolean      @default(false)
  dueDate       DateTime?
  notes         String?      @db.VarChar(400)
  voidReason    String?      @db.VarChar(300)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  lines    SaleLine[]
  receipts Receipt[]
  returns  SalesReturn[]

  @@index([saleDate])
  @@index([customerId])
  @@index([status])
  @@index([cashierId])
}

model SaleLine {
  id          String  @id @default(uuid()) @db.Uuid
  saleId      String  @db.Uuid
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String  @db.Uuid
  product     Product @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  description String  @db.VarChar(300)
  quantity    Decimal @db.Decimal(18, 3)
  unitPrice   Decimal @db.Decimal(18, 2)
  discount    Decimal @default(0) @db.Decimal(18, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  taxAmount   Decimal @default(0) @db.Decimal(18, 2)
  unitCost    Decimal @default(0) @db.Decimal(18, 4)
  lineTotal   Decimal @db.Decimal(18, 2)

  @@index([saleId])
  @@index([productId])
}

model SalesReturn {
  id          String    @id @default(uuid()) @db.Uuid
  reference   String    @unique @db.VarChar(40)
  saleId      String?   @db.Uuid
  sale        Sale?     @relation(fields: [saleId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  customerId  String?   @db.Uuid
  customer    Customer? @relation(fields: [customerId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  returnDate  DateTime  @default(now())
  reason      String?   @db.VarChar(400)
  totalAmount Decimal   @default(0) @db.Decimal(18, 2)
  isRestocked Boolean   @default(true)
  createdAt   DateTime  @default(now())

  lines SalesReturnLine[]

  @@index([saleId])
}

model SalesReturnLine {
  id            String      @id @default(uuid()) @db.Uuid
  salesReturnId String      @db.Uuid
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
  productId     String      @db.Uuid
  product       Product     @relation(fields: [productId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  quantity      Decimal     @db.Decimal(18, 3)
  unitPrice     Decimal     @db.Decimal(18, 2)
  lineTotal     Decimal     @db.Decimal(18, 2)
}

// ---------------------------------------------------------------------------
// FINANCE - receipts (money in), payments (money out), cash, expenses
// ---------------------------------------------------------------------------

// Money received from customers
model Receipt {
  id            String       @id @default(uuid()) @db.Uuid
  reference     String       @unique @db.VarChar(40)
  customerId    String?      @db.Uuid
  customer      Customer?    @relation(fields: [customerId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  saleId        String?      @db.Uuid
  sale          Sale?        @relation(fields: [saleId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  cashSessionId String?      @db.Uuid
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  method        String       @db.VarChar(30)
  status        String       @default("COMPLETED") @db.VarChar(30)
  amount        Decimal      @db.Decimal(18, 2)
  receiptDate   DateTime     @default(now())
  mpesaCode     String?      @db.VarChar(40)
  bankReference String?      @db.VarChar(80)
  userId        String?      @db.Uuid
  user          User?        @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  notes         String?      @db.VarChar(400)
  createdAt     DateTime     @default(now())

  @@index([customerId])
  @@index([receiptDate])
  @@index([status])
}

// Money paid out to suppliers, agents, KRA
model Payment {
  id                String           @id @default(uuid()) @db.Uuid
  reference         String           @unique @db.VarChar(40)
  payeeType         String           @default("SUPPLIER") @db.VarChar(30)
  supplierId        String?          @db.Uuid
  supplier          Supplier?        @relation(fields: [supplierId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  payeeName         String?          @db.VarChar(160)
  supplierInvoiceId String?          @db.Uuid
  supplierInvoice   SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  method            String           @db.VarChar(30)
  status            String           @default("COMPLETED") @db.VarChar(30)
  isDeposit         Boolean          @default(false)
  currency          String           @default("KES") @db.VarChar(3)
  exchangeRate      Decimal          @default(1) @db.Decimal(18, 6)
  amount            Decimal          @db.Decimal(18, 2)
  amountKes         Decimal          @db.Decimal(18, 2)
  paymentDate       DateTime         @default(now())
  bankReference     String?          @db.VarChar(80)
  mpesaCode         String?          @db.VarChar(40)
  userId            String?          @db.Uuid
  user              User?            @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  notes             String?          @db.VarChar(400)
  createdAt         DateTime         @default(now())

  @@index([supplierId])
  @@index([paymentDate])
}

model ExpenseCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(120)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model Expense {
  id            String          @id @default(uuid()) @db.Uuid
  reference     String          @unique @db.VarChar(40)
  categoryId    String          @db.Uuid
  category      ExpenseCategory @relation(fields: [categoryId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  description   String          @db.VarChar(400)
  amount        Decimal         @db.Decimal(18, 2)
  method        String          @default("CASH") @db.VarChar(30)
  expenseDate   DateTime        @default(now())
  payeeName     String?         @db.VarChar(160)
  status        String          @default("APPROVED") @db.VarChar(30)
  userId        String?         @db.Uuid
  user          User?           @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  attachmentUrl String?         @db.VarChar(400)
  createdAt     DateTime        @default(now())

  @@index([expenseDate])
  @@index([categoryId])
}

model CashSession {
  id           String    @id @default(uuid()) @db.Uuid
  reference    String    @unique @db.VarChar(40)
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  openingFloat Decimal   @default(0) @db.Decimal(18, 2)
  closingCount Decimal?  @db.Decimal(18, 2)
  expectedCash Decimal   @default(0) @db.Decimal(18, 2)
  variance     Decimal   @default(0) @db.Decimal(18, 2)
  status       String    @default("OPEN") @db.VarChar(30)
  openedAt     DateTime  @default(now())
  closedAt     DateTime?
  notes        String?   @db.VarChar(400)

  sales    Sale[]
  receipts Receipt[]

  @@index([userId])
  @@index([status])
}

// M-PESA STK push / C2B tracking
model MpesaTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  merchantRequestId String?  @db.VarChar(80)
  checkoutRequestId String?  @db.VarChar(80)
  mpesaReceipt      String?  @db.VarChar(40)
  phoneNumber       String   @db.VarChar(30)
  amount            Decimal  @db.Decimal(18, 2)
  accountReference  String?  @db.VarChar(60)
  saleId            String?  @db.Uuid
  status            String   @default("PENDING") @db.VarChar(30)
  resultCode        Int?
  resultDesc        String?  @db.VarChar(300)
  rawCallback       String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([saleId])
}
