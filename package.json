{
  "name": "saipei-pos",
  "version": "1.1.0",
  "private": true,
  "description": "SAIPEI FOODS LIMITED - Import, Inventory, POS & ERP",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push && node prisma/apply-indexes.mjs",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:indexes": "node prisma/apply-indexes.mjs"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.2",
    "dotenv": "^17.4.2",
    "jose": "6.1.0",
    "lucide-react": "0.545.0",
    "next": "16.3.5",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "24.10.1",
    "@types/pg": "^8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
